PORT=4000
MONGODB_URI=mongodb+srv://developers_db_user:developers123@cluster0.6ttwc0c.mongodb.net/flowGuardian
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
SIMULATION_TICK_MS=4000

FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_AUTH_MODE=none
FHIR_TOKEN_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_PRIVATE_KEY_PEM=
FHIR_SCOPES=system/Patient.read system/Observation.read system/Encounter.read system/Condition.read
HL7_MLLP_PORT=2575

# Automatic FHIR push ingestion (Subscriptions) — no manual import needed.
# FHIR_WEBHOOK_SECRET should be a long random string; it's the only thing
# securing the public webhook endpoint (no user JWT is possible there).
FHIR_WEBHOOK_SECRET=change_this_to_a_long_random_string
# Publicly reachable base URL of this server (e.g. an ngrok tunnel in dev,
# your real domain in production). Required only if FHIR_AUTO_SUBSCRIBE=true.
FHIR_WEBHOOK_BASE_URL=
FHIR_AUTO_SUBSCRIBE=false
